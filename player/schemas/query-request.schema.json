{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mythos.local/schemas/SYS.AI.MAYA.SESAME/query-request.schema.json",
  "title": "Lorepack player query request",
  "description": "JSON in. One request per JSONL line on stdio, one HTTP POST body, one MCP tool call (op = tool name, args = arguments), or one call to session.run(). Per-op args schemas are published in the capability manifest (ops[].input); the player validates args against them before running anything.",
  "type": "object",
  "required": ["op"],
  "properties": {
    "id": { "type": ["string", "integer", "null"], "description": "Echoed in the response." },
    "op": { "type": "string", "enum": ["capabilities_get", "pack_load", "pack_verify", "pack_stats", "sources_list", "vectors_search", "text_search", "graph_traverse", "record_get", "peer_ask"] },
    "pack": { "type": "string", "description": "Pack tag, optionally @version prefix: SYS.AI.MAYA.SESAME@1a2b3c. Optional when one pack is loaded." },
    "args": { "type": "object" }
  },
  "additionalProperties": false,
  "allOf": [
    { "if": { "properties": { "op": { "const": "vectors_search" } } }, "then": { "properties": { "args": { "$ref": "#/$defs/vectors_search" } }, "required": ["args"] } },
    { "if": { "properties": { "op": { "const": "text_search" } } }, "then": { "properties": { "args": { "$ref": "#/$defs/text_search" } }, "required": ["args"] } },
    { "if": { "properties": { "op": { "const": "graph_traverse" } } }, "then": { "properties": { "args": { "$ref": "#/$defs/graph_traverse" } }, "required": ["args"] } },
    { "if": { "properties": { "op": { "const": "record_get" } } }, "then": { "properties": { "args": { "$ref": "#/$defs/record_get" } }, "required": ["args"] } },
    { "if": { "properties": { "op": { "const": "pack_load" } } }, "then": { "properties": { "args": { "$ref": "#/$defs/pack_load" } }, "required": ["args"] } },
    { "if": { "properties": { "op": { "const": "peer_ask" } } }, "then": { "properties": { "args": { "$ref": "#/$defs/peer_ask" } }, "required": ["args"] } }
  ],
  "$defs": {
    "include": { "type": "array", "items": { "enum": ["text", "meta", "vec", "edges"] } },
    "pack_load": { "type": "object", "required": ["ref"], "additionalProperties": false, "properties": { "ref": { "type": "string" }, "tag": { "type": "string" }, "expect": { "type": "object", "additionalProperties": false, "properties": { "agent": { "type": "string" }, "model": { "type": "string" }, "dim": { "type": "integer" }, "version": { "type": "string" } } } } },
    "vectors_search": {
      "type": "object", "additionalProperties": false,
      "description": "Exactly one of text, vector(+model), like_id.",
      "properties": {
        "pack": { "type": "string" },
        "text": { "type": "string" },
        "vector": { "type": "array", "items": { "type": "number" } },
        "model": { "type": "string", "description": "Required with vector. Must equal the pack model." },
        "like_id": { "type": "string" },
        "exclude_self": { "type": "boolean", "default": true },
        "k": { "type": "integer", "minimum": 1, "maximum": 50, "default": 5 },
        "min_score": { "type": "number", "minimum": -1, "maximum": 1 },
        "sources": { "type": "array", "items": { "type": "string" }, "maxItems": 50 },
        "include": { "$ref": "#/$defs/include" },
        "max_chars": { "type": "integer", "minimum": 0, "maximum": 4000, "default": 400 }
      },
      "oneOf": [ { "required": ["text"] }, { "required": ["vector", "model"] }, { "required": ["like_id"] } ]
    },
    "text_search": { "type": "object", "required": ["query"], "additionalProperties": false, "properties": { "pack": { "type": "string" }, "query": { "type": "string", "minLength": 1 }, "mode": { "enum": ["all", "any", "phrase"], "default": "all" }, "scope": { "type": "array", "items": { "enum": ["chunks", "edges"] } }, "k": { "type": "integer", "minimum": 1, "maximum": 50, "default": 10 }, "max_chars": { "type": "integer", "minimum": 0, "maximum": 4000 } } },
    "graph_traverse": { "type": "object", "additionalProperties": false, "properties": { "pack": { "type": "string" }, "start": { "type": "array", "items": { "type": "string" }, "maxItems": 50 }, "chunk_id": { "type": "string" }, "hops": { "type": "integer", "minimum": 1, "maximum": 3, "default": 1 }, "direction": { "enum": ["out", "in", "both"], "default": "both" }, "predicates": { "type": "array", "items": { "type": "string" } }, "exclude_predicates": { "type": "array", "items": { "type": "string" } }, "include_heuristic": { "type": "boolean", "default": false }, "max_edges": { "type": "integer", "minimum": 1, "maximum": 500, "default": 100 } }, "anyOf": [ { "required": ["start"] }, { "required": ["chunk_id"] } ] },
    "record_get": { "type": "object", "required": ["id"], "additionalProperties": false, "properties": { "pack": { "type": "string" }, "id": { "type": "string" }, "include": { "$ref": "#/$defs/include" } } },
    "peer_ask": { "type": "object", "required": ["to", "query"], "additionalProperties": false, "properties": { "to": { "type": "string", "description": "Roster id of the agent to ask." }, "query": { "$ref": "#" }, "max_hops": { "type": "integer", "minimum": 1, "maximum": 4 } } }
  }
}
